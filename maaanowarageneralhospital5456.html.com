<!DOCTYPE html>
<!-- saved from url=(134564)http://maanowara11.12.161456/index.html -->
<html lang="bn"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Maa Anowara General Hospital, Ghata(k) Pukur, Bhangar, South 24 Parganas. Patient care, diagnostics and surgical services.">
  <title>Maa Anowara General Hospital | Digital Healthcare</title>
  <style>
    :root{--navy:#12324a;--teal:#087f8c;--mint:#eaf7f5;--ink:#203342;--muted:#607381;--white:#fff;--line:#dce8ec;--gold:#f4b942}
    *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;font-family:Arial,"Noto Sans Bengali",sans-serif;color:var(--ink);line-height:1.6;background:#fff}
    a{color:inherit;text-decoration:none}.container{width:min(1140px,92%);margin:auto}
    .topbar{background:var(--navy);color:#eaf4f8;font-size:13px;padding:8px 0}.topbar .container{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
    header{background:#fff;position:sticky;top:0;z-index:10;box-shadow:0 3px 18px #102b3b12}
    .nav{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:13px 0}.brand{display:flex;align-items:center;gap:12px;font-weight:800;color:var(--navy)}
    .logo{width:48px;height:48px;border-radius:14px;background:var(--teal);display:grid;place-items:center;color:#fff;font-size:26px;font-weight:bold}
    .brand small{display:block;font-size:11px;color:var(--muted);font-weight:500;letter-spacing:.4px}
    nav{display:flex;gap:20px;align-items:center;font-size:14px;font-weight:700}nav a:hover{color:var(--teal)}
    .btn{display:inline-block;border:0;border-radius:9px;padding:12px 18px;background:var(--teal);color:#fff;font-weight:700;cursor:pointer}
    .btn.secondary{background:#fff;color:var(--teal);border:1px solid #b9dadd}.btn:hover{filter:brightness(.95)}
    .hero{background:linear-gradient(110deg,#0d344bdf,#087f8cce),linear-gradient(45deg,#d8f0ed,#fff);color:#fff;padding:82px 0 76px}
    .hero-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:40px;align-items:center}.eyebrow{font-weight:700;color:#b8f1e9;letter-spacing:1.5px;font-size:13px}
    h1{font-size:clamp(34px,5vw,56px);line-height:1.13;margin:14px 0 18px}.hero p{font-size:18px;max-width:650px;color:#e6f4f5}
    .hero-card{background:#ffffffef;color:var(--ink);border-radius:18px;padding:25px;box-shadow:0 15px 40px #052c3b30}.hero-card h3{margin:0 0 8px;color:var(--navy)}
    .hero-card .number{font-size:24px;color:var(--teal);font-weight:800}.notice{font-size:12px;color:var(--muted);margin-top:12px}
    section{padding:68px 0}.section-head{text-align:center;max-width:720px;margin:0 auto 34px}.section-head .tag{color:var(--teal);font-size:12px;font-weight:800;letter-spacing:1.4px}.section-head h2{font-size:32px;color:var(--navy);margin:8px 0}.section-head p{color:var(--muted);margin:0}
    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{border:1px solid var(--line);border-radius:15px;padding:23px;background:#fff;box-shadow:0 8px 25px #18394a08}.card .ico{width:46px;height:46px;background:var(--mint);border-radius:12px;display:grid;place-items:center;font-size:23px}.card h3{color:var(--navy);margin:14px 0 6px}.card p{color:var(--muted);font-size:14px;margin:0}
    .about{background:#f5fafb}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:42px;align-items:center}.about-panel{background:linear-gradient(145deg,#d8f1ed,#edf7fa);border-radius:20px;min-height:300px;display:grid;place-items:center;text-align:center;padding:30px;color:var(--navy)}.about-panel strong{font-size:25px;display:block}
    .checklist{padding:0;list-style:none}.checklist li{margin:10px 0}.checklist li:before{content:"✓";color:var(--teal);font-weight:bold;margin-right:10px}
    .departments{background:#fff}.dept{display:flex;gap:12px;align-items:flex-start}.dept b{display:block;color:var(--navy)}.dept span{font-size:13px;color:var(--muted)}
    .appointment{background:var(--mint)}.formbox{max-width:760px;margin:auto;background:#fff;padding:28px;border-radius:18px;box-shadow:0 10px 30px #0b59600d}
    form{display:grid;grid-template-columns:1fr 1fr;gap:15px}label{font-size:13px;font-weight:700;color:var(--navy)}input,select,textarea{width:100%;padding:12px;border:1px solid var(--line);border-radius:8px;margin-top:6px;font:inherit;background:#fff}textarea{min-height:95px;resize:vertical}.full{grid-column:1/-1}.form-note{font-size:12px;color:var(--muted)}
    .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.contact-card{background:#f7fafb;border:1px solid var(--line);border-radius:15px;padding:24px}.contact-card h3{margin-top:0;color:var(--navy)}
    footer{background:var(--navy);color:#dbeaf0;padding:38px 0 18px}.footer-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:25px}footer h3,footer h4{color:#fff;margin-top:0}footer p,footer a{font-size:13px;color:#d2e2e8}footer a:hover{color:#fff}.copyright{border-top:1px solid #ffffff25;margin-top:25px;padding-top:15px;font-size:12px;color:#b9cbd2}
    .mobile-cta{display:none}
    @media(max-width:800px){nav{display:none}.hero-grid,.about-grid,.contact-grid,.footer-grid{grid-template-columns:1fr}.cards{grid-template-columns:repeat(2,1fr)}.hero{padding:55px 0}.hero-card{max-width:480px}}
    @media(max-width:540px){.cards{grid-template-columns:1fr}section{padding:50px 0}form{grid-template-columns:1fr}.full{grid-column:auto}.topbar .container{font-size:11px}.brand{font-size:14px}.mobile-cta{display:flex;position:fixed;bottom:0;left:0;right:0;background:#fff;padding:9px;gap:8px;z-index:20;box-shadow:0 -4px 18px #102b3b20}.mobile-cta a{flex:1;text-align:center;font-size:13px}.copyright{padding-bottom:55px}}
  </style>
</head>
<body>
  <div class="topbar"><div class="container"><span>📍 Ghata(k) Pukur, Bhangar, South 24 Parganas, West Bengal</span><span>Patient Care • Diagnostics • Surgical Services</span></div></div>
  <header><div class="container nav">
    <a class="brand" href="http://127.0.0.1:5500/index.html#home"><span class="logo">✚</span><span>MAA ANOWARA GENERAL HOSPITAL<small>CARE • COMPASSION • COMMITMENT</small></span></a>
    <nav><a href="http://127.0.0.1:5500/index.html#home">Home</a><a href="http://127.0.0.1:5500/index.html#about">About</a><a href="http://127.0.0.1:5500/index.html#services">Services</a><a href="http://127.0.0.1:5500/index.html#departments">Departments</a><a href="http://127.0.0.1:5500/index.html#appointment">Appointment</a><a href="http://127.0.0.1:5500/index.html#contact">Contact</a></nav>
    <a class="btn" href="http://127.0.0.1:5500/index.html#appointment">Book Appointment</a>
  </div></header>
  <main>
    <section class="hero" id="home"><div class="container hero-grid">
      <div><div class="eyebrow">WELCOME TO DIGITAL HEALTHCARE</div><h1>Your Health,<br>Our Responsibility.</h1>
        <p>মা আনোয়ারা জেনারেল হাসপাতালে আপনাকে স্বাগতম। রোগীর যত্ন, সম্মান এবং নিরাপদ চিকিৎসা পরিষেবাকে আমরা গুরুত্ব দিই।</p>
        <a class="btn" href="http://127.0.0.1:5500/index.html#appointment">Appointment Request</a> <a class="btn secondary" href="http://127.0.0.1:5500/index.html#services">Our Services</a>
      </div>
      <div class="hero-card"><h3>Hospital Information</h3><div class="number">Maa Anowara</div><p>General Hospital</p><hr style="border:0;border-top:1px solid #dce8ec">
        <p><b>Location</b><br>Ghata(k) Pukur, Bhangar<br>South 24 Parganas, West Bengal</p>
        <p><b>Emergency</b><br>Please contact the hospital reception directly.</p>
        <div class="notice">হাসপাতালের ফোন নম্বর ও জরুরি যোগাযোগের তথ্য কর্তৃপক্ষের অনুমোদনের পর এখানে যোগ করুন।</div>
      </div>
    </div></section>
    <section id="about" class="about"><div class="container about-grid">
      <div><div class="section-head" style="text-align:left;margin:0 0 15px"><div class="tag">ABOUT OUR HOSPITAL</div><h2>মানসম্মত চিকিৎসা, মানবিক পরিষেবা</h2></div>
        <p>মা আনোয়ারা জেনারেল হাসপাতাল রোগীদের প্রয়োজন অনুযায়ী চিকিৎসা ও স্বাস্থ্য পরিষেবা প্রদানের লক্ষ্যে কাজ করে। আমাদের লক্ষ্য হলো রোগী ও তাঁদের পরিবারের জন্য যত্নশীল, সম্মানজনক এবং দায়িত্বশীল স্বাস্থ্যসেবা নিশ্চিত করা।</p>
        <ul class="checklist"><li>রোগীকেন্দ্রিক চিকিৎসা পরিষেবা</li><li>প্রশিক্ষিত চিকিৎসক ও স্বাস্থ্যকর্মী</li><li>প্রয়োজন অনুযায়ী পরীক্ষা-নিরীক্ষা ও চিকিৎসা</li><li>পরিষ্কার-পরিচ্ছন্ন ও নিরাপদ পরিবেশ</li></ul>
      </div>
      <div class="about-panel"><div><div style="font-size:55px">✚</div><strong>MAA ANOWARA</strong><span>GENERAL HOSPITAL</span><p>Compassionate care for every patient</p></div></div>
    </div></section>
    <section id="services"><div class="container"><div class="section-head"><div class="tag">OUR SERVICES</div><h2>আমাদের চিকিৎসা পরিষেবা</h2><p>হাসপাতালে উপলব্ধ পরিষেবার অনুমোদিত তালিকা অনুযায়ী এই বিভাগটি আপডেট করা যাবে।</p></div>
      <div class="cards">
        <article class="card"><div class="ico">🩺</div><h3>General Medicine</h3><p>সাধারণ রোগের পরামর্শ, পরীক্ষা ও চিকিৎসা।</p></article>
        <article class="card"><div class="ico">⚕️</div><h3>General Surgery</h3><p>প্রয়োজন অনুযায়ী সার্জারি সংক্রান্ত পরামর্শ ও চিকিৎসা।</p></article>
        <article class="card"><div class="ico">🧪</div><h3>Pathology</h3><p>চিকিৎসকের পরামর্শ অনুযায়ী ল্যাবরেটরি পরীক্ষা।</p></article>
        <article class="card"><div class="ico">🩻</div><h3>Imaging &amp; Diagnostics</h3><p>উপলব্ধ সুবিধা অনুযায়ী ডায়াগনস্টিক পরীক্ষা।</p></article>
        <article class="card"><div class="ico">🏥</div><h3>In-patient Care</h3><p>ভর্তিকৃত রোগীদের চিকিৎসা ও পর্যবেক্ষণ।</p></article>
        <article class="card"><div class="ico">👨‍⚕️</div><h3>Specialist Consultation</h3><p>চিকিৎসকের সময়সূচি ও প্রাপ্যতা অনুযায়ী বিশেষজ্ঞ পরামর্শ।</p></article>
      </div>
    </div></section>
    <section id="departments" class="departments"><div class="container"><div class="section-head"><div class="tag">DEPARTMENTS</div><h2>চিকিৎসা বিভাগ</h2><p>চিকিৎসক ও বিভাগভিত্তিক সময়সূচি হাসপাতাল কর্তৃপক্ষের কাছ থেকে নিশ্চিত করে প্রকাশ করুন।</p></div>
      <div class="cards">
        <article class="card dept"><div class="ico">🩺</div><div><b>Medicine</b><span>General medical consultation</span></div></article>
        <article class="card dept"><div class="ico">🔬</div><div><b>Surgery</b><span>Surgical consultation and care</span></div></article>
        <article class="card dept"><div class="ico">🦴</div><div><b>Orthopaedics</b><span>Bone and joint care</span></div></article>
        <article class="card dept"><div class="ico">💤</div><div><b>Anaesthesia</b><span>Anaesthesia assessment and support</span></div></article>
        <article class="card dept"><div class="ico">🧫</div><div><b>Pathology</b><span>Laboratory investigations</span></div></article>
        <article class="card dept"><div class="ico">🩻</div><div><b>Diagnostics</b><span>Available diagnostic services</span></div></article>
      </div>
    </div></section>
    <section class="appointment" id="appointment"><div class="container"><div class="section-head"><div class="tag">APPOINTMENT</div><h2>অ্যাপয়েন্টমেন্টের অনুরোধ</h2><p>নিচের ফর্মটি পূরণ করুন। এটি বর্তমানে ডেমো ফর্ম; অনলাইনে জমা ও হাসপাতালের কাছে পাঠানোর জন্য backend/WhatsApp integration লাগবে।</p></div>
      <div class="formbox"><form id="appointmentForm">
        <label>রোগীর নাম / Patient Name<input required="" name="patient" placeholder="আপনার নাম"></label>
        <label>মোবাইল নম্বর / Phone<input required="" name="phone" type="tel" placeholder="10-digit mobile number" pattern="[0-9+\-\s]{10,15}"></label>
        <label>বিভাগ / Department<select name="department"><option>General Medicine</option><option>General Surgery</option><option>Orthopaedics</option><option>Pathology / Diagnostics</option><option>Other</option></select></label>
        <label>পছন্দের তারিখ / Preferred Date<input name="date" type="date"></label>
        <label class="full">সমস্যার বিবরণ / Message<textarea name="message" placeholder="সংক্ষেপে সমস্যার কথা লিখুন"></textarea></label>
        <div class="full"><button class="btn" type="submit">Submit Request</button><p class="form-note">জরুরি অবস্থায় অনলাইন ফর্মের জন্য অপেক্ষা করবেন না—নিকটস্থ জরুরি চিকিৎসা পরিষেবা নিন।</p><p id="formMessage" role="status"></p></div>
      </form></div>
    </div></section>
    <section id="contact"><div class="container"><div class="section-head"><div class="tag">CONTACT US</div><h2>যোগাযোগ করুন</h2><p>হাসপাতালে আসার আগে ফোন করে বিভাগ ও পরিষেবার প্রাপ্যতা নিশ্চিত করুন।</p></div>
      <div class="contact-grid"><div class="contact-card"><h3>📍 Hospital Address</h3><p>Maa Anowara General Hospital<br>Ghata(k) Pukur, Bhangar<br>South 24 Parganas, West Bengal, India</p><p><b>Phone:</b> [9733212618]<br><b>Email:</b> [maaanowara@gmail.com]</p></div>
      <div class="contact-card"><h3>🕒 Visiting Information</h3><p><b>OPD Timing:</b> [সময় যোগ করুন]<br><b>Emergency:</b> [জরুরি পরিষেবার সময়/নম্বর নিশ্চিত করে যোগ করুন]<br><b>Appointment:</b> Reception-এর সঙ্গে যোগাযোগ করুন।</p><p class="form-note">সময়, ফোন নম্বর ও জরুরি পরিষেবার তথ্য প্রকাশের আগে হাসপাতাল কর্তৃপক্ষ যাচাই করবেন।</p></div></div>
    </div></section>
  </main>
  <footer><div class="container"><div class="footer-grid">
    <div><h3>✚ Maa Anowara General Hospital</h3><p>রোগীর যত্ন, সম্মান ও দায়িত্বশীল স্বাস্থ্যসেবার অঙ্গীকার।</p></div>
    <div><h4>Quick Links</h4><p><a href="http://127.0.0.1:5500/index.html#about">About Us</a><br><a href="http://127.0.0.1:5500/index.html#services">Services</a><br><a href="http://127.0.0.1:5500/index.html#departments">Departments</a><br><a href="http://127.0.0.1:5500/index.html#appointment">Appointment</a></p></div>
    <div><h4>Address</h4><p>Ghata(k) Pukur, Bhangar<br>South 24 Parganas, West Bengal</p></div>
  </div><div class="copyright">© <span id="year"></span> Maa Anowara General Hospital. All rights reserved. | Website information subject to hospital confirmation.</div></div></footer>
  <div class="mobile-cta"><a class="btn" href="http://127.0.0.1:5500/index.html#appointment">Appointment</a><a class="btn secondary" href="http://127.0.0.1:5500/index.html#contact">Contact</a></div>
  <script>
    document.getElementById('year').textContent = new Date().getFullYear();
    document.getElementById('appointmentForm').addEventListener('submit', function(e){
      e.preventDefault();
      document.getElementById('formMessage').textContent = 'ধন্যবাদ। 
    });
  </script>
<!-- Code injected by live-server -->
<script>
	// <![CDATA[  <-- For SVG support
